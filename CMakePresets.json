{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/Build_msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AES_ENABLE_AESNI": "ON",
        "AES_BUILD_TESTS": "ON",
        "AES_BUILD_BENCH": "ON"
      }
    },
    {
